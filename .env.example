# OpenWeatherMap API Configuration
# This API key will be used for all users (they don't need to provide their own)
# Get your free API key at https://openweathermap.org/api

# API key for user access (required for real weather data)
VITE_OPENWEATHER_API_KEY=your_api_key_here

# Proxy server configuration (optional - for enhanced security in production)
# VITE_API_PROXY_URL=http://localhost:3001